{
  "name": "civicsync-backend",
  "version": "2.0.0",
  "private": false,
  "description": "CivicSync civic issue escalation - demo backend (Express + SQLite, $0 stack)",
  "main": "server/index.cjs",
  "scripts": {
    "start": "node server/index.cjs",
    "setup:detector": "node scripts/download-model.cjs",
    "test": "node --test test/*.cjs",
    "demo": "node scripts/demo.cjs",
    "build:web": "npm --prefix frontend ci && npm --prefix frontend run build",
    "start:web": "node scripts/serve-web.cjs"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "express": "^5.3.0",
    "http-proxy": "^1.18.1",
    "onnxruntime-node": "1.30.0",
    "sharp": "0.35.5"
  }
}
